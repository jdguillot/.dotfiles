// Style: minimal — close to the previous look. Tight gaps, thin solid focus
// ring, square corners, no shadows, stock animations.

layout {
    gaps 4
    background-color "transparent"
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 1.5
        active-color "#cba6f7"
        inactive-color "transparent"
        urgent-color "#f38ba8"
    }

    border {
        off
    }
}
