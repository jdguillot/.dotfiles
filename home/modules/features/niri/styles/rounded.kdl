// Style: rounded — the community-consensus niri look. Rounded corners,
// soft shadows, catppuccin-mocha gradient focus ring spanning the workspace
// view, snappy critically-damped springs.

layout {
    gaps 8
    background-color "transparent"
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        // Gradient spans the whole scrolling strip, so each window shows a
        // different slice as you scroll (mauve -> pink).
        active-gradient from="#cba6f7" to="#f5c2e7" angle=45 relative-to="workspace-view"
        inactive-color "transparent"
        urgent-color "#f38ba8"
    }

    border {
        off
    }

    shadow {
        on
        softness 30
        spread 4
        offset x=0 y=5
        draw-behind-window false
        color "#00000070"
    }

    tab-indicator {
        hide-when-single-tab
        place-within-column
        position "left"
        gap 4
        width 4
        gaps-between-tabs 2
        corner-radius 8
        length total-proportion=0.5
        active-color "#cba6f7"
        inactive-color "#585b70"
    }
}

animations {
    workspace-switch { spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001; }
    horizontal-view-movement { spring damping-ratio=1.0 stiffness=900 epsilon=0.0001; }
    window-movement { spring damping-ratio=1.0 stiffness=800 epsilon=0.0001; }
    window-resize { spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001; }
    window-open { duration-ms 200; curve "ease-out-quad"; }
    window-close { duration-ms 150; curve "ease-out-quad"; }
    overview-open-close { spring damping-ratio=1.0 stiffness=900 epsilon=0.0001; }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
}
