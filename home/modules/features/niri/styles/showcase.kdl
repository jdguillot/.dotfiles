// Style: showcase — the full rice. Bigger gaps, oklch rainbow gradient ring,
// blur behind translucent terminals (niri 26.04+), inactive-window dimming,
// slightly bouncy window-open animation.

layout {
    gaps 12
    background-color "transparent"
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        // oklch "longer hue" sweeps through the whole hue wheel between the
        // two colors — the pastel rainbow look from YaLTeR's own config.
        active-gradient from="#cba6f7" to="#f5c2e7" angle=45 relative-to="workspace-view" in="oklch longer hue"
        inactive-color "transparent"
        urgent-color "#f38ba8"
    }

    border {
        off
    }

    shadow {
        on
        softness 40
        spread 5
        offset x=0 y=6
        draw-behind-window false
        color "#00000080"
    }

    tab-indicator {
        hide-when-single-tab
        place-within-column
        position "left"
        gap 5
        width 4
        gaps-between-tabs 2
        corner-radius 8
        length total-proportion=0.5
        active-color "#cba6f7"
        inactive-color "#585b70"
    }

}

blur {
    passes 3
    offset 3
    noise 0.02
}

animations {
    workspace-switch { spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001; }
    horizontal-view-movement { spring damping-ratio=1.0 stiffness=900 epsilon=0.0001; }
    window-movement { spring damping-ratio=0.9 stiffness=800 epsilon=0.0001; }
    window-resize { spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001; }
    window-open { spring damping-ratio=0.8 stiffness=1000 epsilon=0.0001; }
    window-close { duration-ms 150; curve "ease-out-quad"; }
    overview-open-close { spring damping-ratio=1.0 stiffness=900 epsilon=0.0001; }
}

window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
    draw-border-with-background false
}

// Translucent terminal with real blur behind it.
window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    opacity 0.92
    background-effect {
        blur true
        xray false
    }
}

// Subtle focus hierarchy: unfocused windows dim slightly.
window-rule {
    match is-active=false
    opacity 0.95
}
