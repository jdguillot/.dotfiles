// Shell layer for niri: DankMaterialShell (cyberfighter.features.niri.shell
// = "dank"). Included after base.kdl; because niri binds are "later wins",
// the two entries below (Mod+V, Mod+Comma) intentionally override the
// window-motion binds of the same name in base.kdl — this is DMS's stock
// preset keymap (its niri homeModule's enableKeybinds), reproduced as KDL
// text because our niri config is text, not niri-flake `settings`.

spawn-at-startup "dms" "run"

binds {
    Mod+Space hotkey-overlay-title="Application Launcher" { spawn "dms" "ipc" "spotlight" "toggle"; }
    Mod+N     hotkey-overlay-title="Notification Center" { spawn "dms" "ipc" "notifications" "toggle"; }
    Mod+Comma hotkey-overlay-title="DMS Settings" { spawn "dms" "ipc" "settings" "toggle"; }
    Mod+P     hotkey-overlay-title="Notepad" { spawn "dms" "ipc" "notepad" "toggle"; }
    Mod+X     hotkey-overlay-title="Power Menu" { spawn "dms" "ipc" "powermenu" "toggle"; }
    Mod+W     hotkey-overlay-title="Wallpaper Carousel" { spawn "dms" "ipc" "wallpaperCarousel" "toggle"; }
    // Same key as noctalia's session menu, so the two shells agree; Mod+X
    // stays as DMS's stock preset key.
    Mod+Escape hotkey-overlay-title="Power Menu" { spawn "dms" "ipc" "powermenu" "toggle"; }
    Mod+V     hotkey-overlay-title="Clipboard Manager" { spawn "dms" "ipc" "clipboard" "toggle"; }
    Mod+M     hotkey-overlay-title="Process List" { spawn "dms" "ipc" "processlist" "toggle"; }
    Super+Alt+L hotkey-overlay-title="Lock the Screen" { spawn "dms" "ipc" "lock" "lock"; }
    Mod+Alt+N allow-when-locked=true hotkey-overlay-title="Toggle Night Mode" { spawn "dms" "ipc" "night" "toggle"; }

    XF86AudioRaiseVolume  allow-when-locked=true { spawn "dms" "ipc" "audio" "increment" "3"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "dms" "ipc" "audio" "decrement" "3"; }
    XF86AudioMute         allow-when-locked=true { spawn "dms" "ipc" "audio" "mute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "dms" "ipc" "audio" "micmute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "dms" "ipc" "brightness" "increment" "5" ""; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "brightness" "decrement" "5" ""; }

    // DMS presets omit media-transport keys; keep them useful via playerctl.
    XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }

    // DMS 1.6 ships its own capture tool (region select with confirm,
    // annotation, and a scrolling stitched capture niri has no equivalent
    // for). Overrides base.kdl's niri built-ins, which stay in effect under
    // noctalia. Both save to ~/Pictures/Screenshots.
    //
    // S for snip is the everyday family; the Print row mirrors omarchy (and
    // every other desktop) for muscle memory. Mod+Alt+S is deliberately not
    // used: Mod is Super, so it would take over base.kdl's orca toggle.
    Mod+S            hotkey-overlay-title="Screenshot: Region" { spawn "dms" "screenshot"; }
    Mod+Shift+S      hotkey-overlay-title="Screenshot: Window" { spawn "dms" "screenshot" "window"; }
    Mod+Ctrl+S       hotkey-overlay-title="Screenshot: Screen" { spawn "dms" "screenshot" "full"; }
    Mod+Ctrl+Shift+S hotkey-overlay-title="Screenshot: Scrolling Region" { spawn "dms" "screenshot" "scroll"; }

    Print       hotkey-overlay-title="Screenshot: Region" { spawn "dms" "screenshot"; }
    Ctrl+Print  hotkey-overlay-title="Screenshot: Screen" { spawn "dms" "screenshot" "full"; }
    Alt+Print   hotkey-overlay-title="Screenshot: Window" { spawn "dms" "screenshot" "window"; }
    Shift+Print hotkey-overlay-title="Screenshot: Scrolling Region" { spawn "dms" "screenshot" "scroll"; }

    // omarchy puts its colour picker on Super+Print; DMS has one too.
    Mod+Print hotkey-overlay-title="Colour Picker" { spawn "dms" "ipc" "call" "color-picker" "toggle"; }
}

// DMS regenerates these from its Settings GUI; they are derived files, so
// the repo tracks their source (settings.json, mirrored by dank-capture)
// rather than the fragments themselves. Relative to ~/.config/niri because
// niri resolves includes against the path a file was included by, and DMS
// greps for exactly this form to decide whether a fragment is wired up.
// This layer is included after the style, so DMS owns the knobs its GUI
// exposes -- gaps, border and focus-ring width, corner radius -- while the
// style keeps what DMS never writes (shadows, blur, springs, the gradient
// focus ring, column presets).
include "dms/layout.kdl" optional=true
include "dms/colors.kdl" optional=true
include "dms/input.kdl" optional=true
include "dms/cursor.kdl" optional=true
include "dms/windowrules.kdl" optional=true
include "dms/alttab.kdl" optional=true
include "dms/wpblur.kdl" optional=true
include "dms/binds.kdl" optional=true
include "dms/outputs.kdl" optional=true
