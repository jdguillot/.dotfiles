{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (matt-daemon)",
      "options": {
        "baseURL": "{env:OLLAMA_BASE_URL}"
      },
      "models": {}
    },
    "ryzn-remote": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ryzn (team remote)",
      "options": {
        "baseURL": "{env:RYZN_LLM_BASE_URL}",
        "apiKey": "{env:RYZN_LLM_KEY}",
        "headers": {
          "CF-Access-Client-Id": "{env:RYZN_CF_ID}",
          "CF-Access-Client-Secret": "{env:RYZN_CF_SECRET}"
        }
      },
      "models": {
        "team-coder": {
          "name": "Qwen3.8 27B (team)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "team-small": {
          "name": "Qwen3.5 4B (team)",
          "limit": {
            "context": 16384,
            "output": 8192
          }
        }
      }
    }
  }
}
