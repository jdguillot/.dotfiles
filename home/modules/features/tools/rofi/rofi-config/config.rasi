@theme "launcher"
configuration {
  // keyboard bindings
  kb-element-next: "Control+j";
  kb-element-prev: "Control+k";
  kb-remove-to-eol: "";
  kb-accept-entry: "Return,KP_Enter";
  kb-mode-next: "Tab";
  kb-mode-previous: "Shift+Tab";

  // Window
  show-icons: true;
  display-drun: "󰀻 Apps";
  display-window: "󱂬 Windows";
  display-run: " Run";
  drun-display-format: "{name}";
  window-display-format: "{name}";
}
