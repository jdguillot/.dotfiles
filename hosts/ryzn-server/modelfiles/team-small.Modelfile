# Aux model for litellm/hermes. num_ctx capped: at the 256K server window
# even this 4B allocates 9.2GiB of KV and evicts the 27B primary; at 16K it
# cost ~3.8GiB, at 8K ~3.4GiB, leaving room beside the 27B and the
# OLLAMA_GPU_OVERHEAD reservation for Immich ML.
FROM qwen3.5:4b-q4_K_M
PARAMETER num_ctx 8192
