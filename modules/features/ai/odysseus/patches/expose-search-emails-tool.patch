Expose the MCP email server's search_emails tool to the agent.

Upstream wired search_emails into security/capabilities/conversion
(BUILTIN_EMAIL_TOOLS includes it) but never gave it a schema in
FUNCTION_TOOL_SCHEMAS, a tool_index description, or a slot in the email
domain map -- so tool selection can never offer it and the model pages
list_emails instead of searching. Mirror list_emails' three catalog
entries. No upstream issue yet; the tool itself already works end to end
once offered.

--- a/src/tool_schemas.py
+++ b/src/tool_schemas.py
@@ -1141,6 +1141,23 @@
                 },
             }
         }
     },
+    {
+        "type": "function",
+        "function": {
+            "name": "search_emails",
+            "description": "Search emails by free-text query matched against sender, subject, and body. Walks INBOX, Sent, and Archive by default so older threads are findable, not just the recent inbox slice. Use whenever the user asks to find or search for specific emails, or names a sender or topic. Returns matching emails with UIDs for read_email/reply_to_email.",
+            "parameters": {
+                "type": "object",
+                "properties": {
+                    "query": {"type": "string", "description": "Free-text query. Matches FROM, SUBJECT, and body TEXT."},
+                    "folders": {"type": "array", "items": {"type": "string"}, "description": "Folders to search (default: INBOX, Sent, Archive)"},
+                    "max_results": {"type": "integer", "description": "Max results per folder (default: 20)"},
+                    "account": {"type": "string", "description": "Optional account name/email/id from list_email_accounts"},
+                },
+                "required": ["query"],
+            }
+        }
+    },
     {
         "type": "function",
